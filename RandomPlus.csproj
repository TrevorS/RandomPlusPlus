<Project Sdk="Microsoft.NET.Sdk">

  <!-- Detects a local RimWorld install and sets UseLocalRimWorld / RimWorldManaged -->
  <Import Project="RimWorld.targets" />

  <PropertyGroup>
    <!--
    net472 is the target the RimWorld modding ecosystem standardises on, and the
    one the Krafs.Rimworld.Ref reference assemblies ship for. Mono loads it fine
    under Unity 2022.3 / RimWorld 1.6.
    -->
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>RandomPlus</AssemblyName>
    <RootNamespace>RandomPlus</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!--
    Which RimWorld version this build targets. Defaulted in Directory.Build.props,
    which also gives each version its own obj/. Tools/build.sh builds them all;
    dotnet build on its own produces the default version only.
    -->
    <OutputPath>Resources/$(RimWorldVersion)/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- A mod assembly is loaded by the game, not run as an app - no deps.json wanted -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
  The reference assemblies for each supported game version. Adding a version means
  adding a row here and a row in Tools/build.sh, and listing it in About.xml -
  Tools/package.sh fails the build if those disagree.
  -->
  <PropertyGroup>
    <RimWorldRefVersion Condition="'$(RimWorldVersion)' == '1.6'">1.6.4871</RimWorldRefVersion>
    <RimWorldRefVersion Condition="'$(RimWorldVersion)' == '1.5'">1.5.4409</RimWorldRefVersion>
  </PropertyGroup>

  <Target Name="CheckRimWorldVersionIsKnown" BeforeTargets="PrepareForBuild"
          Condition="'$(UseLocalRimWorld)' != 'true' And '$(RimWorldRefVersion)' == ''">
    <Error Text="RimWorldVersion '$(RimWorldVersion)' has no reference assembly version. Add one to RandomPlus.csproj." />
  </Target>

  <!-- Dependency versions, kept in one place -->
  <PropertyGroup>
    <!--
    Matches the Harmony library loaded at runtime by the Harmony mod
    (brrainz.harmony), so the compile-time surface is the runtime surface.
    -->
    <HarmonyVersion>2.4.1</HarmonyVersion>
    <NetFrameworkRefVersion>1.0.3</NetFrameworkRefVersion>
  </PropertyGroup>

  <!-- Assembly metadata, generated by the SDK rather than a hand-maintained AssemblyInfo.cs -->
  <PropertyGroup>
    <!--
    AssemblyName stays RandomPlus: it is the file RimWorld loads and the name in
    every existing log and bug report. The descriptive fields name the fork.
    -->
    <Product>RandomPlusPlus</Product>
    <AssemblyTitle>RandomPlusPlus</AssemblyTitle>
    <Authors>TrevorS, mastertea</Authors>
    <Company>TrevorS</Company>
    <Copyright>Copyright © 2018 mastertea, © 2026 TrevorS. MIT.</Copyright>
    <Description>Auto-rerolls starting pawns until they match a user-defined specification.</Description>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- The mod's own version, the same in every per-game-version build -->
    <Version>1.0.0</Version>
    <!--
    The SDK's implicit SourceLink appends the git commit to InformationalVersion,
    which bakes the current SHA into the binary - so the committed assemblies
    could never match a rebuild made at any later commit. Off, so a clean build
    is byte-reproducible regardless of git state.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <!-- Ship only the assembly; keep debug symbols out of Release output -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Source/**/*.cs" />
  </ItemGroup>

  <!-- Lets the .NET SDK build net472 without a Windows/Mono framework install -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="$(NetFrameworkRefVersion)" PrivateAssets="all" />
  </ItemGroup>

  <!--
  Harmony is supplied at runtime by the Harmony mod (brrainz.harmony), which
  About.xml already declares as a dependency. Reference-only here: ExcludeAssets
  keeps 0Harmony.dll out of the mod's Assemblies folder, where a second copy
  would conflict with the one the Harmony mod loads.
  -->
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="$(HarmonyVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!--
  RimWorld assemblies. A local game install is preferred when present; otherwise
  fall back to the redistributable reference assemblies from NuGet so the project
  builds anywhere, including CI with no game installed.
  -->
  <ItemGroup Condition="'$(UseLocalRimWorld)' == 'true'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)/Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)/UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManaged)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManaged)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(RimWorldManaged)/UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalRimWorld)' != 'true'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldRefVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!--
  Every .NET analyser rule is on and every warning is an error. The exceptions are
  in .editorconfig, one at a time with a reason, so a rule that is wrong for a
  RimWorld mod is switched off deliberately rather than by never enabling it.
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
  Record the assemblies this build compiled against. Tools/RandomPlus.Verify reads
  the manifest so it checks the mod against exactly what was used, whether that came
  from NuGet reference assemblies or a local RimWorld installation.
  -->
  <Target Name="WriteReferenceManifest" AfterTargets="ResolveReferences">
    <WriteLinesToFile File="$(BaseIntermediateOutputPath)references.txt"
                      Lines="@(ReferencePath)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
