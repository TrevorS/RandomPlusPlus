<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RandomPlus.Tests</AssemblyName>
    <RootNamespace>RandomPlus.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
  The whole of Source/Core, compiled against the stubs in Stubs/ instead of RimWorld.
  Globbing the folder rather than listing files means a new core file is tested the
  moment it exists, and that a core file reaching for UnityEngine or the UI breaks
  this build immediately - there are no stubs for either. The boundary is enforced,
  not just documented.
  -->
  <ItemGroup>
    <Compile Include="../../Source/Core/**/*.cs" LinkBase="Core" />
    <Compile Include="Stubs/RimWorldStubs.cs" />
    <Compile Include="Harness.cs" />
    <Compile Include="Tests.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
